# Server
NODE_ENV=development
PORT=5000
TRUST_PROXY=false
COOKIE_SECURE=false

# Database
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/DATABASE

# Public URLs
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:5000

# Authentication — replace these with unique random values
JWT_ACCESS_SECRET=replace-with-a-unique-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-refresh-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThis-Password-123!
ADMIN_SEED_KEY=replace-with-a-unique-random-seed-key-at-least-32-characters
ENABLE_DEMO_DATA=false

# Media
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Email — Resend or SMTP
# Admin order alerts. Blank uses EMAIL_SMTP_USER, then ADMIN_EMAIL.
NOTIFICATION_EMAIL=
# auto preserves API-first selection; choose smtp or api explicitly if both exist.
EMAIL_PROVIDER=auto
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_KEY=your-resend-api-key
EMAIL_FROM=Sarker Fabrics <onboarding@resend.dev>
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=your-smtp-user
EMAIL_SMTP_PASSWORD=your-smtp-password

# SSLCommerz
SSLCOMMERZ_STORE_ID=your-store-id
SSLCOMMERZ_STORE_PASSWORD=your-store-password
SSLCOMMERZ_SANDBOX=true

# Courier integration (server only). Fill credentials, then restart the backend.
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PATHAO_ENVIRONMENT=production
REDX_ACCESS_TOKEN=
REDX_PICKUP_STORE_ID=
REDX_ENVIRONMENT=production
COURIER_DEFAULT_WEIGHT_KG=0.5

# Required for admin-managed courier settings: generate 32 random bytes as 64 hex characters.
# Keep this key stable and back it up with the database; never expose it to the frontend.
COURIER_SETTINGS_ENCRYPTION_KEY=
